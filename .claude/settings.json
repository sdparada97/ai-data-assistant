{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)"
    ],
    "allow": [
      "Bash(openspec validate:*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions:*)",
      "Bash(graphify query:*)",
      "Bash(graphify update:*)",
      "Bash(make test)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sdparada/.pyenv/versions/3.14.7/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sdparada/.pyenv/versions/3.14.7/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
